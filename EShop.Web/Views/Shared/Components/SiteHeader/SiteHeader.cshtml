 <!-- header -->
<header>
    <div class="header-container">
        <a href="home.html" class="logo-container">
            <img class="logo" src="../assets/images/logo.png">
        </a>

        <div class="search-container">
            <i class="fas fa-search"></i>
            <input class="search"
                   id="search"
                   placeholder="جستجوی کتاب ..."
                   onkeydown="handleSearch(event)" />
        </div>

        <div class="nav-links">
            <a href="home.html">خانه</a>
            <a href="about.html">درباره ما</a>
            <a href="contact.html">تماس با ما</a>
            <div class="cart-icon" id="cartIcon">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-count">0</span>
            </div>
        </div>
        <div class="auth-Link">
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-area="" asp-controller="" asp-action="" class="auth-btn">
                    <i class="bi bi-person"></i>
                    <span class="font-weight-bold d-sm-inline-block" d-none>حساب کاربری</span>
                </a>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="RegisterOrLogin" class="auth-btn">
                    <i class="bi bi-person"></i>
                    <span class="font-weight-bold d-sm-inline-block" d-none>عضویت / ورود</span>
                </a>

            }

        </div>

        <div class="hamburger" id="hamburger">
            <i class="fas fa-bars"></i>
        </div>
    </div>
</header>