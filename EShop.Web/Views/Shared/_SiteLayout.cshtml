
@{     
    ViewData["Title"] = "Shop";
    Layout = null; 
}

<html lang="en">
<head>
    <partial name="_SiteMetaTags" />
    <partial name="_SiteHeaderRef" />
    @RenderSection("_SiteHeaderSection", false)
    <title>@ViewData["Title"]</title>
</head>
<body>

    <!-- menu mobile  -->
    <div class="mobile-nav" id="mobileNav">
        <div class="mobile-nav-header">
            <a href="home.html" class="logo-container">
                <img class="logo" src="../assets/images/logo.png">
            </a>
            <div class="close-menu" id="closeMenu">
                <i class="fas fa-times"></i>
            </div>
        </div>

        <div class="mobile-nav-links">
            <a href="home.html">خانه</a>
            <a href="about.html">درباره ما</a>
            <a href="contact.html">تماس با ما</a>
            <a href="#" id="mobileCartBtn"> سبد خرید </a>

        </div>
    </div>

    <div class="overlay" id="overlay"></div>
       

    @Component.InvokeAsync("SiteHeader")
    @RenderBody()
    @Component.InvokeAsync("SiteFooter")
    @Component.InvokeAsync("HomeCartSection")
    <partial name="_SiteMobileMenu" />
    <partial name="_SiteFooterRef" />
  

</body>
</html>